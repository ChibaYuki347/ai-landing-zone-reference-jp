# プリセット: 最小構成（デモ・開発用）
#
# 用途: 機能確認、開発、デモ
# 所要時間: 10-15 分
# 概算コスト: 月 ~400 USD（インフラのみ）
#
# 使い方:
#   .\scripts\Set-Preset.ps1 -Preset minimal -EnvName ailz-demo
#   cd infra-upstream ; azd up

AZURE_LOCATION=swedencentral

# ネットワーク: パブリックエンドポイント（閉域なし）
NETWORK_ISOLATION=false

# デプロイモード
DEPLOYMENT_MODE=standalone
GREEN_FIELD_DEPLOYMENT=true

# 運用アクセス系はすべて無効（コスト削減）
DEPLOY_VM=false
DEPLOY_JUMPBOX=false
DEPLOY_BASTION=false
DEPLOY_NAT_GATEWAY=false
DEPLOY_AZURE_FIREWALL=false
DEPLOY_SOFTWARE=false

# AI コンポーネント
DEPLOY_AAF_AGENT_SVC=true
DEPLOY_SEARCH_SERVICE=true
DEPLOY_MCP=true

# オプション機能は無効
DEPLOY_GROUNDING_WITH_BING=false
DEPLOY_SPEECH_SERVICE=false
DEPLOY_POSTGRES=false
DEPLOY_HOSTED_AGENT=false
DEPLOY_ACR_TASK_AGENT_POOL=false

# 検索バックエンド
RETRIEVAL_BACKEND=foundry_iq
FOUNDRY_IQ_KNOWLEDGE_RETRIEVAL_BILLING_PLAN=free

# 命名
RESOURCE_NAMING_MODE=caf
CAF_ENVIRONMENT_NAME=dev
