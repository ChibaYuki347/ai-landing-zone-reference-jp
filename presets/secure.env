# プリセット: 閉域構成（Zero Trust / 本番相当）
#
# 用途: 本番相当の検証、パイロット
# 所要時間: 20-25 分
# 概算コスト: 月 ~785 USD（インフラのみ）
#
# 特徴:
#   - 全 PaaS に Private Endpoint、パブリックアクセス無効
#   - Bastion + Jumpbox で運用アクセス
#   - Azure Firewall なし（送信は NAT Gateway 経由）
#     → 月 ~900 USD の節約。FQDN レベルの送信制御が必要なら full.env を使用
#
# 使い方:
#   .\scripts\Set-Preset.ps1 -Preset secure -EnvName ailz-secure
#   cd infra-upstream ; azd up

AZURE_LOCATION=swedencentral

# ネットワーク: Zero Trust
NETWORK_ISOLATION=true

# デプロイモード
DEPLOYMENT_MODE=standalone
GREEN_FIELD_DEPLOYMENT=true

# 運用アクセス
DEPLOY_VM=true
DEPLOY_JUMPBOX=true
DEPLOY_BASTION=true
DEPLOY_NAT_GATEWAY=true
DEPLOY_SOFTWARE=true
BASTION_SKU_NAME=Standard
BASTION_ENABLE_TUNNELING=true
AZURE_VM_SIZE=Standard_D2s_v3

# Firewall なし（中央管理を想定 / コスト削減）
DEPLOY_AZURE_FIREWALL=false

# AI コンポーネント
DEPLOY_AAF_AGENT_SVC=true
DEPLOY_SEARCH_SERVICE=true
DEPLOY_MCP=true
DEPLOY_KEY_VAULT=true
DEPLOY_LOG_ANALYTICS=true

# オプション機能
DEPLOY_GROUNDING_WITH_BING=false
DEPLOY_SPEECH_SERVICE=false
DEPLOY_POSTGRES=false
DEPLOY_HOSTED_AGENT=false

# 検索バックエンド
RETRIEVAL_BACKEND=foundry_iq
FOUNDRY_IQ_KNOWLEDGE_RETRIEVAL_BILLING_PLAN=free

# 命名
RESOURCE_NAMING_MODE=caf
CAF_ENVIRONMENT_NAME=test
